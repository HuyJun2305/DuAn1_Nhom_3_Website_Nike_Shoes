@model IEnumerable<AppView.Models.HoaDon>

@{
    Layout = "AdminLayout";
    ViewData["Title"] = "Danh Sách Hóa Đơn";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>UserName</th>
            <th>Ngày Tạo</th>
            <th>Tổng Tiền</th>
            <th>Trạng Thái</th>
            <th>Người Bán</th>
            <th>Phương Thức Thanh Toán</th>
@*             <th>Trạng Thái Đơn Hàng</th> <!-- Thêm cột trạng thái đơn hàng -->
 *@            <th>Thao Tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hoaDon in Model)
        {
            <tr>
                <td>@hoaDon.Id</td>
                <td>@hoaDon.KhachHang.UserName</td>
                <td>@hoaDon.NgayTao.ToString("dd/MM/yyyy")</td>
                <td>@hoaDon.TongTien.ToString("N2")</td>
                <td>@(hoaDon.TrangThai ? "Đã thanh toán" : "Chưa thanh toán")</td>
                <td>@hoaDon.NguoiBan</td>
                <td>@hoaDon.DonHang.PhuongThucThanhToan</td>
@*                 <td>@hoaDon.DonHang?.TrangThaiDonHang</td> <!-- Hiển thị trạng thái đơn hàng -->
 *@                <td>
                    @if (!hoaDon.TrangThai)
                    {
                        <form asp-action="PayInvoice" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@hoaDon.Id" />
                            <button type="submit" class="btn btn-success btn-sm">Thanh Toán</button>
                        </form>
                    }
                    @if (hoaDon.TrangThai)
                    {
                        <form asp-action="CancelInvoice" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@hoaDon.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Hủy Thanh Toán</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
