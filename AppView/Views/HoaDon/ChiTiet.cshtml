@model AppView.Models.HoaDon

@{
    ViewData["Title"] = "Chi Tiết Hóa Đơn";
}

<h1>Chi Tiết Hóa Đơn</h1>

<div class="card">
    <div class="card-header">
        <h4>Thông Tin Hóa Đơn</h4>
    </div>
    <div class="card-body">
        <p><strong>ID Hóa Đơn:</strong> @Model.Id</p>
        <p><strong>Ngày Tạo:</strong> @Model.NgayTao.ToString("dd/MM/yyyy")</p>
        <p><strong>Tổng Tiền:</strong> @string.Format("{0:N0}₫", Model.TongTien)</p>
        <p><strong>Trạng Thái:</strong> @(Model.TrangThai ? "Đã Thanh Toán" : "Chưa Thanh Toán")</p>
        <p><strong>Người Bán:</strong> @Model.NguoiBan</p>
        <p><strong>Khách Hàng:</strong> @Model.KhachHang.Ten</p>
        <p><strong>Địa Chỉ:</strong> @Model.DonHang.DiaChi</p>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h4>Chi Tiết Đơn Hàng</h4>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Tên Sản Phẩm</th>
                    <th>Đơn Giá</th>
                    <th>Số Lượng</th>
                    <th>Thành Tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DonHang != null && Model.DonHang.ChiTietDonHangs != null)
                {
                    foreach (var chiTiet in Model.DonHang.ChiTietDonHangs)
                    {
                        <tr>
                            <td>@chiTiet.SanPham.Ten</td>
                            <td>@string.Format("{0:N0}₫", chiTiet.Gia)</td>
                            <td>@chiTiet.SoLuong</td>
                            <td>@string.Format("{0:N0}₫", chiTiet.Gia * chiTiet.SoLuong)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">Không có chi tiết đơn hàng</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a asp-action="DanhSachHoaDon" class="btn btn-secondary">Quay lại</a>
</div>
