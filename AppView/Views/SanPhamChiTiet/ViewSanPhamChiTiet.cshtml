@model AppView.ViewModels.ProductDetailViewModel

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container d-flex justify-content-center " style="min-height: 100vh;">
    <div class="row justify-content-center ">
        <aside class="col-md-6 text-center">
            <img src="@Url.Content(Model.ImgFile)" alt="Hình ảnh sản phẩm" class="img-fluid" style="max-width: 100%; height: auto; object-fit: contain;">
        </aside>
        <div class="col-md-5 ">
            <h1>@Model.Ten</h1>
            <hr />
            <h3>Giá: @string.Format("{0:N0}₫", Model.Gia)</h3>
            <p>Số lượng: @Model.SoLuong</p>
            <p>Size: @Model.Size</p>
            <form asp-action="AddToCart" method="post">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="form-group d-flex  ">
                    <label for="quantity" class="me-2 mb-0">Số lượng:</label>
                    <input type="number" id="quantity" name="quantity" class="form-control me-2" min="1" value="1" style="width: 80px;" />
                    <button type="submit" class="btn btn-primary">Thêm vào giỏ hàng</button>
                </div>
                <p>@Model.MoTa</p>
            </form>


        </div>
    </div>
</div>
