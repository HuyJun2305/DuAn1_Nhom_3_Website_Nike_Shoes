@model AppView.ViewModels.NhapThongTinTraHangViewModel

@{
    ViewData["Title"] = "Nhập Thông Tin Trả Hàng";
}

<h1 class="text-center">Nhập Thông Tin Trả Hàng</h1>

<form asp-action="XacNhanTraHang" method="post">
    <input type="hidden" asp-for="IdDonHang" />

    <div class="form-group">
        <label for="tenNguoiNhan">Tên Người Trả</label>
        <input type="text" class="form-control" id="tenNguoiNhan" name="TenNguoiNhan" asp-for="TenNguoiTra" readonly />
    </div>

    <div class="form-group">
        <label for="ngayTao">Ngày Tạo</label>
        <input type="text" class="form-control" id="ngayTao" name="NgayTao" value="@Model.NgayTao.ToString("dd/MM/yyyy")" readonly />
    </div>

    <div class="form-group">
        <label for="tongTien">Tổng Tiền</label>
        <input type="text" class="form-control" id="tongTien" name="TongTien" value="@Model.TongTien.ToString("N2")" readonly />
    </div>
        
    <div class="form-group">
        <label for="phuongThucThanhToan">Phương Thức Thanh Toán</label>
        <input type="text" class="form-control" id="phuongThucThanhToan" name="PhuongThucThanhToan" asp-for="PhuongThucThanhToan" readonly />
    </div>

    <div class="form-group">
        <label for="diaChi">Địa Chỉ Trả Hàng</label>
        <input type="text" class="form-control" id="diaChi" name="DiaChi" asp-for="DiaChi" required />
    </div>

    <div class="form-group">
        <label for="soDienThoai">Số Điện Thoại</label>
        <input type="text" class="form-control" id="soDienThoai" name="SoDienThoai" asp-for="SoDienThoai" required />
    </div>

    <div class="form-group">
        <label for="ghiChu">Ghi Chú</label>
        <textarea class="form-control" id="ghiChu" name="GhiChu" asp-for="GhiChu"></textarea>
    </div>

    <div class="form-group">
        <label>Chi Phí Hoàn Trả</label>
        <input type="text" class="form-control" value="@Model.PhiHoanTra.ToString("N2")" readonly />
    </div>

    <button type="submit" class="btn btn-primary">Xác Nhận Trả Hàng</button>
</form>
